# 应用配置
APP_NAME=校园百事通
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 数据库
DATABASE_URL=sqlite:///./data/campus_helper.db

# 向量数据库
CHROMA_PERSIST_DIR=./data/knowledge_base
CHROMA_COLLECTION_NAME=campus_knowledge

# AI模型配置
# 选择使用的模型: openai, anthropic, local
LLM_PROVIDER=openai

# OpenAI配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic配置
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# 本地模型配置 (使用Ollama)
LOCAL_MODEL_URL=http://localhost:11434
LOCAL_MODEL_NAME=qwen:7b

# Embedding模型
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu

# RAG配置
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=50

# 安全配置
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 日志
LOG_LEVEL=INFO
LOG_FILE=./logs/campus_helper.log
